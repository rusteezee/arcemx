{
  "name": "arcstride",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ArcStride — local-first training workbench. Built on the ArcArmor design system (System A).",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && SINGLE=1 vite build --outDir dist-single",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.0",
    "@fontsource-variable/geist-mono": "^5.2.0",
    "@garmin/fitsdk": "^21.0.0",
    "fflate": "^0.8.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
