# Arc'emX! bot env - fill in real values (same as Render's current set,
# verified live 2026-07-14), then: sudo systemctl restart arcemx-bot
# This file is chmod 600 by setup.sh and never overwritten on rerun once
# it exists, so it's safe to fill in once and forget.

SUPABASE_URL=
SUPABASE_KEY=
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TRIGGER_SECRET=
GH_TOKEN=
GH_REPO=

# Needed by the scheduled jobs this box now runs itself (blueprint 22).
# GNEWS_API_KEY: gnews.io dashboard, free tier. Optional - fetchers/news.py
# still works on RSS alone without it, GNews is a supplement.
# HC_PING_URLS: JSON map of job name to its healthchecks.io ping URL, e.g.
#   {"hourly_news":"https://hc-ping.com/xxx","daily_prices":"https://hc-ping.com/yyy"}
# Keys used today: hourly_news, daily_prices, daily_sync, alerts_checker,
# stock_analyst_dispatch (Phase A) plus daily_analysis, daily_grader,
# sensei_eod (still on GH Actions until Phase B). A missing key just means
# that job runs unmonitored - no crash, but no dead-man alert either.
GNEWS_API_KEY=
HC_PING_URLS=

# Fixed convention this deploy assumes - the Caddyfile reverse-proxies to
# this exact port. Change both together if you need a different one.
PORT=8080

# In-process fallback for scheduled_analysis stays refused by default on
# this small box (see bot/telegram_bot.py's ARCEMX_ALLOW_INPROCESS_ANALYSIS
# guard) - GH Actions' secondary cron covers it. Leave at 0 unless you
# specifically want this box to run the heavy analysis path itself.
ARCEMX_ALLOW_INPROCESS_ANALYSIS=0
