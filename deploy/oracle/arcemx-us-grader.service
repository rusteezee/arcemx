[Unit]
Description=Arc'emX! US brief grader, scores briefs against real closes (blueprint 25 Phase 3)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/arcemx
EnvironmentFile=/etc/arcemx.env
ExecStart=/opt/arcemx/deploy/oracle/run_job.sh us_grader us.grader
TimeoutStartSec=600
MemoryMax=1G
