[Unit]
Description=Arc'emX! US holdings sync, 12:30 UTC (18:00 IST, before the US open in both EDT and EST) and 21:30 UTC (after the close in both) Mon-Fri. Fires on US holidays too, which is harmless: values just stay unchanged.

[Timer]
OnCalendar=Mon..Fri *-*-* 12:30:00
OnCalendar=Mon..Fri *-*-* 21:30:00
AccuracySec=1s
Persistent=true

[Install]
WantedBy=timers.target
