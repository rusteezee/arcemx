[Unit]
Description=Arc'emX! git pull every 5 minutes

[Timer]
# Every scheduled job runs against code pushed within the last 5 minutes -
# the same currency GH Actions gave for free by checking out ref: master on
# every dispatch.
OnCalendar=*:0/5
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
