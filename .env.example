# OpenRouter. Free tier: 20 req/min, 50 req/day. Sized for our 1/day cron
# + manual syncs. Default chain: Nemotron 3 Super (primary) -> MiniMax M3
# (fallback), both free-tier OpenRouter models - no other provider is
# configured (Gemini/Groq escalation removed 2026-08-27). Override via
# OPENROUTER_PRIMARY / OPENROUTER_FALLBACKS if needed.
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=your_chat_id

# Reddit (optional). Official OAuth app registration is gated shut as of
# late 2025 (Responsible Builder Policy - reddit.com/prefs/apps blocks
# "create app" outright now). REDDIT_CLIENT_ID/SECRET stay wired as a
# dormant fallback if approval is ever granted; APIFY_API_TOKEN below is
# the real path. See fetchers/reddit.py.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=arcemx/0.1

# Apify (optional, ~free at low volume - trudax/reddit-scraper-lite actor,
# $0.004/result, $5/month free platform credit). Powers Reddit sentiment
# since Reddit's own API is gated shut. Keep the per-subreddit limit in
# analyzer/aggregator.py's fetch_hot() call at 10 or lower to stay inside
# the free credit - see fetchers/reddit.py for the real measured cost math.
APIFY_API_TOKEN=

# GNews (optional, 100/day free)
GNEWS_API_KEY=

# INDmoney MCP (auto-filled by indmoney_auth.py after first OAuth login)
INDMONEY_MCP_URL=https://mcp.indmoney.com/mcp
INDMONEY_TOKEN_FILE=.indmoney_tokens.json

# INDstocks real-order execution (blueprint 19). off = fully inert.
# confirm = Telegram Execute/Skip button per new paper trade. auto is not
# implemented - locked behind the Phase B Tier-1 + DSR gate.
INDSTOCKS_EXEC_MODE=off
INDSTOCKS_MAX_ORDER_INR=5000
INDSTOCKS_MAX_DAILY_ORDERS=3
